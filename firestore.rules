rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow read for everyone (leaderboards)
      allow read: if true;
      // Allow write if authenticated anonymously (in a real app, verify Telegram initData via Cloud Functions)
      allow write: if request.auth != null;
    }
    match /referrals/{referralId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
